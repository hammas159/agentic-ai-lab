---
import Base from "../layouts/Base.astro";

// Every map written by `cartographer map --json -o ui/public/data/<name>.json`.
const maps = import.meta.glob("/public/data/*.json", { eager: true });

const repos = Object.entries(maps)
  .map(([path, mod]: [string, any]) => {
    const d = mod.default ?? mod;
    return { slug: path.split("/").pop()!.replace(/\.json$/, ""), ...d };
  })
  .sort((a, b) => b.repo_resolution_rate - a.repo_resolution_rate);

const pct = (n: number) => `${Math.round(n * 100)}%`;
const band = (n: number) => (n >= 0.9 ? "good" : n >= 0.7 ? "warn" : "bad");

const totals = {
  repos: repos.length,
  modules: repos.reduce((s, r) => s + r.modules, 0),
  symbols: repos.reduce((s, r) => s + r.symbols, 0),
  loc: repos.reduce((s, r) => s + r.loc, 0),
};
const median = (() => {
  const xs = repos.map((r) => r.repo_resolution_rate).sort((a, b) => a - b);
  if (!xs.length) return 0;
  const m = Math.floor(xs.length / 2);
  return xs.length % 2 ? xs[m] : (xs[m - 1] + xs[m]) / 2;
})();
---

<Base title="Portfolio map">
  <div class="stats">
    <div class="stat"><div class="v">{totals.repos}</div><div class="k">repositories</div></div>
    <div class="stat"><div class="v">{totals.modules}</div><div class="k">modules</div></div>
    <div class="stat"><div class="v">{totals.symbols.toLocaleString()}</div><div class="k">definitions</div></div>
    <div class="stat"><div class="v">{totals.loc.toLocaleString()}</div><div class="k">lines</div></div>
    <div class="stat"><div class="v">{pct(median)}</div><div class="k">median resolution</div></div>
  </div>

  <div class="note">
    <strong>Resolution</strong> counts only calls that could bind to a definition in the
    repository. Builtins, the standard library and methods on third-party objects are
    excluded - counting them makes every codebase look unmappable.
  </div>

  <h2>Repositories</h2>
  <div class="tablewrap">
    <table>
      <thead>
        <tr>
          <th>Repository</th>
          <th class="num">Modules</th>
          <th class="num">Defs</th>
          <th class="num">Lines</th>
          <th>Resolution</th>
          <th>Load-bearing module</th>
        </tr>
      </thead>
      <tbody>
        {repos.map((r) => (
          <tr>
            <td><a href={`${import.meta.env.BASE_URL}${r.slug}/`}>{r.name}</a></td>
            <td class="num">{r.modules}</td>
            <td class="num">{r.symbols}</td>
            <td class="num">{r.loc.toLocaleString()}</td>
            <td>
              <span class={`rate ${band(r.repo_resolution_rate)}`}>
                {pct(r.repo_resolution_rate)}
              </span>
              <div class="bar"><span style={`width:${r.repo_resolution_rate * 100}%`}></span></div>
            </td>
            <td class="mono">{r.core_modules[0]?.module ?? "-"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
