---
import "../styles/global.css";

interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - repo-cartographer</title>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <h1><a href={import.meta.env.BASE_URL}>repo-cartographer</a></h1>
        <p>{subtitle ?? "Mapped from the AST. No embeddings, no model."}</p>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>
